# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# App URL — em produção usa o domínio real (ex: https://hoophub.pt)
# Usado nos links de ativação enviados por email
NEXT_PUBLIC_APP_URL=https://hoophub.pt

# Resend — https://resend.com/api-keys
# Domínio hoophub.pt deve estar verificado em https://resend.com/domains
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@hoophub.pt

# Anthropic (AI assistant) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Segredo dos tokens de ativação (≥32 bytes aleatórios: openssl rand -hex 32). Obrigatório em produção.
ACTIVATION_SECRET=

# Segredo das rotas /api/cron/* (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>"). Obrigatório.
CRON_SECRET=

# DeepSeek — leitura de folhas de jogo, notícias e outras funções de IA (só servidor)
DEEPSEEK_API_KEY=
# Modelo de texto (notícias, calendário). Default: deepseek-v4-flash
DEEPSEEK_MODEL=
# Modelo COM VISÃO para os boletins de jogo (tem de aceitar imagens). Default: deepseek-flash
DEEPSEEK_VISION_MODEL=

# Importação inteligente do boletim (opcionais — valores por omissão entre parênteses)
# Segunda leitura das regiões duvidosas: on|off (on)
GAME_SHEET_SECOND_PASS=
# Máximo de análises por boletim, incluindo reanálises (3)
GAME_SHEET_MAX_ANALYSES=
# Máximo de importações por utilizador por hora (15)
GAME_SHEET_MAX_IMPORTS_PER_HOUR=
# Tokens de saída da leitura completa (8192; o retry por truncagem usa no máximo o dobro)
GAME_SHEET_MAX_OUTPUT_TOKENS=
# Orçamento de tempo por análise em ms (50000; a função tem maxDuration 60 s)
GAME_SHEET_TIME_BUDGET_MS=
